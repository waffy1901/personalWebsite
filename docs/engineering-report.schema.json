{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private repository engineering report v2 or v3",
  "type": "object",
  "required": ["schema_version", "repository", "as_of", "collected_at", "first_observed_at", "repository_created_at", "default_branch", "sources", "coverage", "rollups", "samples"],
  "additionalProperties": false,
  "if": {"properties": {"schema_version": {"const": 3}}},
  "then": {"required": ["ai_usage"]},
  "else": {"not": {"required": ["ai_usage"]}},
  "properties": {
    "schema_version": {"enum": [2, 3]},
    "ai_usage": {"$ref": "#/$defs/ai_usage"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$"},
    "as_of": {"$ref": "#/$defs/timestamp"},
    "collected_at": {"$ref": "#/$defs/timestamp"},
    "first_observed_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "repository_created_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "default_branch": {
      "anyOf": [{"type": "object", "required": ["name", "sha"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}, {"type": "null"}]
    },
    "sources": {
      "type": "object",
      "required": ["commits", "pull_requests", "issues", "workflow_runs", "releases", "deployments", "code_scanning", "dependabot"],
      "additionalProperties": false,
      "properties": {
        "commits": {"$ref": "#/$defs/url"},
        "pull_requests": {"$ref": "#/$defs/url"},
        "issues": {"$ref": "#/$defs/url"},
        "workflow_runs": {"$ref": "#/$defs/url"},
        "releases": {"$ref": "#/$defs/url"},
        "deployments": {"$ref": "#/$defs/url"},
        "code_scanning": {"$ref": "#/$defs/url"},
        "dependabot": {"$ref": "#/$defs/url"}
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "commits", "pull_requests", "issues", "commit_churn", "merged_pr_size", "issue_lifecycle",
        "workflow_runs", "releases", "deployments", "deployment_states", "code_scanning", "dependabot"
      ],
      "additionalProperties": false,
      "properties": {
        "commits": {"$ref": "#/$defs/coverage"},
        "pull_requests": {"$ref": "#/$defs/coverage"},
        "issues": {"$ref": "#/$defs/coverage"},
        "commit_churn": {"$ref": "#/$defs/coverage"},
        "merged_pr_size": {"$ref": "#/$defs/coverage"},
        "issue_lifecycle": {"$ref": "#/$defs/coverage"},
        "workflow_runs": {"$ref": "#/$defs/coverage"},
        "releases": {"$ref": "#/$defs/coverage"},
        "deployments": {"$ref": "#/$defs/coverage"},
        "deployment_states": {"$ref": "#/$defs/coverage"},
        "code_scanning": {"$ref": "#/$defs/coverage"},
        "dependabot": {"$ref": "#/$defs/coverage"}
      }
    },
    "rollups": {
      "type": "object",
      "required": ["daily", "weekly", "monthly", "lifetime"],
      "additionalProperties": false,
      "properties": {
        "daily": {"type": "array", "items": {"$ref": "#/$defs/period"}},
        "weekly": {"type": "array", "items": {"$ref": "#/$defs/period"}},
        "monthly": {"type": "array", "items": {"$ref": "#/$defs/period"}},
        "lifetime": {"$ref": "#/$defs/period"}
      }
    },
    "samples": {
      "type": "object",
      "required": ["merged_prs", "issue_closures"],
      "additionalProperties": false,
      "properties": {
        "merged_prs": {"type": "array", "items": {"$ref": "#/$defs/merged_pr_sample"}, "maxItems": 5},
        "issue_closures": {"type": "array", "items": {"$ref": "#/$defs/issue_closure_sample"}, "maxItems": 5}
      }
    }
  },
  "$defs": {
    "ai_usage": {
      "type": "object",
      "required": ["input_schema_version", "excluded", "series"],
      "additionalProperties": false,
      "properties": {
        "input_schema_version": {"const": 1},
        "excluded": {
          "type": "object",
          "required": ["after_cutoff", "unresolved_work_item"],
          "additionalProperties": false,
          "properties": {
            "after_cutoff": {"$ref": "#/$defs/count"},
            "unresolved_work_item": {"$ref": "#/$defs/count"}
          }
        },
        "series": {"type": "array", "items": {"$ref": "#/$defs/ai_series"}}
      }
    },
    "ai_series": {
      "type": "object",
      "required": ["scope", "provider", "model", "work_item", "observations", "rollups"],
      "additionalProperties": false,
      "if": {"properties": {"scope": {"const": "account"}}},
      "then": {"properties": {"work_item": {"type": "null"}}},
      "properties": {
        "scope": {"enum": ["account", "repository"]},
        "provider": {"$ref": "#/$defs/ai_slug"},
        "model": {"anyOf": [{"$ref": "#/$defs/ai_slug"}, {"type": "null"}]},
        "work_item": {
          "type": ["object", "null"],
          "required": ["url", "origin"],
          "additionalProperties": false,
          "properties": {
            "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+/(issues|pull)/[1-9][0-9]{0,19}$"},
            "origin": {"const": "source_recorded"}
          }
        },
        "observations": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ai_observation"}
        },
        "rollups": {
          "type": "object",
          "required": ["daily", "weekly", "monthly", "lifetime"],
          "additionalProperties": false,
          "properties": {
            "daily": {"type": "array", "items": {"$ref": "#/$defs/ai_window"}},
            "weekly": {"type": "array", "items": {"$ref": "#/$defs/ai_window"}},
            "monthly": {"type": "array", "items": {"$ref": "#/$defs/ai_month"}},
            "lifetime": {"$ref": "#/$defs/ai_window"}
          }
        }
      }
    },
    "ai_slug": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "ai_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "ai_metric_name": {"enum": ["input_tokens", "output_tokens", "total_tokens", "sessions", "tool_calls", "duration_seconds"]},
    "ai_observation": {
      "type": "object",
      "required": ["source", "start", "end", "metrics"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/ai_slug"},
        "start": {"$ref": "#/$defs/ai_date"},
        "end": {"$ref": "#/$defs/ai_date"},
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/ai_metric_name"},
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
        }
      }
    },
    "ai_window_fields": {
      "type": "object",
      "required": ["start", "end", "covered_days", "record_count", "metrics"],
      "properties": {
        "start": {"$ref": "#/$defs/ai_date"},
        "end": {"$ref": "#/$defs/ai_date"},
        "covered_days": {"$ref": "#/$defs/record_id"},
        "record_count": {"$ref": "#/$defs/record_id"},
        "metrics": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "total_tokens", "sessions", "tool_calls", "duration_seconds"],
          "propertyNames": {"$ref": "#/$defs/ai_metric_name"},
          "additionalProperties": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]}
        }
      }
    },
    "ai_window": {"$ref": "#/$defs/ai_window_fields", "unevaluatedProperties": false},
    "ai_month": {
      "$ref": "#/$defs/ai_window_fields",
      "required": ["repository_prs_merged"],
      "unevaluatedProperties": false,
      "properties": {"repository_prs_merged": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]}}
    },
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "url": {"type": "string", "format": "uri"},
    "record_id": {"type": "integer", "minimum": 1},
    "count": {"type": "integer", "minimum": 0},
    "coverage": {
      "type": "object",
      "required": ["status", "expected", "collected", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable", "not_collected"]},
        "expected": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
        "collected": {"$ref": "#/$defs/count"},
        "reason": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "earliest_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "duration": {
      "type": "object",
      "required": ["unit", "n", "small_sample", "median", "p90"],
      "additionalProperties": false,
      "properties": {
        "unit": {"const": "seconds"},
        "n": {"$ref": "#/$defs/count"},
        "small_sample": {"type": "boolean"},
        "median": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "p90": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]}
      }
    },
    "size": {
      "type": "object",
      "required": ["unit", "n", "small_sample", "median", "p90", "buckets"],
      "additionalProperties": false,
      "properties": {
        "unit": {"const": "lines"},
        "n": {"$ref": "#/$defs/count"},
        "small_sample": {"type": "boolean"},
        "median": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "p90": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
        "buckets": {
          "type": "object",
          "required": ["0-49", "50-199", "200-499", "500+"],
          "additionalProperties": false,
          "properties": {
            "0-49": {"$ref": "#/$defs/count"},
            "50-199": {"$ref": "#/$defs/count"},
            "200-499": {"$ref": "#/$defs/count"},
            "500+": {"$ref": "#/$defs/count"}
          }
        }
      }
    },
    "line_totals": {
      "type": "object",
      "required": ["additions", "deletions", "file_touches"],
      "additionalProperties": false,
      "properties": {
        "additions": {"$ref": "#/$defs/count"},
        "deletions": {"$ref": "#/$defs/count"},
        "file_touches": {"$ref": "#/$defs/count"}
      }
    },
    "period": {
      "type": "object",
      "required": ["start", "end", "partial", "history_available", "contribution", "issues", "delivery", "ci_cd", "quality"],
      "additionalProperties": false,
      "properties": {
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"},
        "partial": {"type": "boolean"},
        "history_available": {"type": "boolean"},
        "contribution": {
          "type": "object",
          "required": ["commits", "active_days", "non_merge_commits", "churn"],
          "additionalProperties": false,
          "properties": {
            "commits": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "active_days": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "non_merge_commits": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "churn": {
              "anyOf": [{"type": "object", "required": ["raw", "eligible"], "additionalProperties": false, "properties": {"raw": {"$ref": "#/$defs/line_totals"}, "eligible": {"$ref": "#/$defs/line_totals"}}}, {"type": "null"}]
            }
          }
        },
        "issues": {
          "type": "object",
          "required": ["opened", "closed", "reopened", "outstanding_end", "resolution_time"],
          "additionalProperties": false,
          "properties": {
            "opened": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "closed": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "reopened": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "outstanding_end": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "resolution_time": {"anyOf": [{"$ref": "#/$defs/duration"}, {"type": "null"}]}
          }
        },
        "delivery": {
          "type": "object",
          "required": ["prs_opened", "prs_merged", "prs_closed_unmerged", "time_to_merge", "merged_pr_size"],
          "additionalProperties": false,
          "properties": {
            "prs_opened": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "prs_merged": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "prs_closed_unmerged": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
            "time_to_merge": {"anyOf": [{"$ref": "#/$defs/duration"}, {"type": "null"}]},
            "merged_pr_size": {"anyOf": [{"$ref": "#/$defs/size"}, {"type": "null"}]}
          }
        },
        "ci_cd": {
          "type": "object",
          "required": ["workflow_runs", "releases", "deployments"],
          "additionalProperties": false,
          "properties": {
            "workflow_runs": {"anyOf": [{"$ref": "#/$defs/workflow_runs"}, {"type": "null"}]},
            "releases": {"anyOf": [{"$ref": "#/$defs/releases"}, {"type": "null"}]},
            "deployments": {"anyOf": [{"$ref": "#/$defs/deployments"}, {"type": "null"}]}
          }
        },
        "quality": {
          "type": "object",
          "required": ["code_scanning", "dependabot"],
          "additionalProperties": false,
          "properties": {
            "code_scanning": {"anyOf": [{"$ref": "#/$defs/alerts"}, {"type": "null"}]},
            "dependabot": {"anyOf": [{"$ref": "#/$defs/alerts"}, {"type": "null"}]}
          }
        }
      }
    },
    "counts_by_label": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z_]{0,39}$"},
      "additionalProperties": {"$ref": "#/$defs/count"}
    },
    "workflow_runs": {
      "type": "object",
      "required": ["total", "unfinished", "by_conclusion", "duration", "by_workflow"],
      "additionalProperties": false,
      "properties": {
        "total": {"$ref": "#/$defs/count"},
        "unfinished": {"$ref": "#/$defs/count"},
        "by_conclusion": {"$ref": "#/$defs/counts_by_label"},
        "duration": {"$ref": "#/$defs/duration"},
        "by_workflow": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]+$"},
          "additionalProperties": {"$ref": "#/$defs/workflow"}
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["total", "unfinished", "by_conclusion", "duration", "path", "latest_run_url"],
      "additionalProperties": false,
      "properties": {
        "total": {"$ref": "#/$defs/count"},
        "unfinished": {"$ref": "#/$defs/count"},
        "by_conclusion": {"$ref": "#/$defs/counts_by_label"},
        "duration": {"$ref": "#/$defs/duration"},
        "path": {"type": ["string", "null"], "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"},
        "latest_run_url": {"$ref": "#/$defs/url"}
      }
    },
    "releases": {
      "type": "object",
      "required": ["published", "deployment_provenance"],
      "additionalProperties": false,
      "properties": {
        "published": {"$ref": "#/$defs/count"},
        "deployment_provenance": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]}
      }
    },
    "deployments": {
      "type": "object",
      "required": ["created", "by_state"],
      "additionalProperties": false,
      "properties": {
        "created": {"$ref": "#/$defs/count"},
        "by_state": {"anyOf": [{"$ref": "#/$defs/counts_by_label"}, {"type": "null"}]}
      }
    },
    "alerts": {
      "type": "object",
      "required": ["opened", "resolved"],
      "additionalProperties": false,
      "properties": {
        "opened": {
          "type": "object",
          "required": ["total", "by_severity"],
          "additionalProperties": false,
          "properties": {
            "total": {"$ref": "#/$defs/count"},
            "by_severity": {"$ref": "#/$defs/counts_by_label"}
          }
        },
        "resolved": {
          "anyOf": [{
            "type": "object",
            "required": ["total", "by_severity", "by_reason"],
            "additionalProperties": false,
            "properties": {
              "total": {"$ref": "#/$defs/count"},
              "by_severity": {"$ref": "#/$defs/counts_by_label"},
              "by_reason": {"$ref": "#/$defs/counts_by_label"}
            }
          }, {"type": "null"}]
        }
      }
    },
    "merged_pr_sample": {
      "type": "object",
      "required": ["number", "opened_at", "merged_at", "seconds", "lines_changed", "url"],
      "additionalProperties": false,
      "properties": {
        "number": {"$ref": "#/$defs/record_id"},
        "opened_at": {"$ref": "#/$defs/timestamp"},
        "merged_at": {"$ref": "#/$defs/timestamp"},
        "seconds": {"$ref": "#/$defs/count"},
        "lines_changed": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
        "url": {"$ref": "#/$defs/url"}
      }
    },
    "issue_closure_sample": {
      "type": "object",
      "required": ["number", "event_id", "opened_at", "closed_at", "seconds", "url"],
      "additionalProperties": false,
      "properties": {
        "number": {"$ref": "#/$defs/record_id"},
        "event_id": {"$ref": "#/$defs/record_id"},
        "opened_at": {"$ref": "#/$defs/timestamp"},
        "closed_at": {"$ref": "#/$defs/timestamp"},
        "seconds": {"$ref": "#/$defs/count"},
        "url": {"$ref": "#/$defs/url"}
      }
    }
  }
}
