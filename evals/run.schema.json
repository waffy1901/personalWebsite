{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalWebsite evaluation run, format 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","slot","task","repeat","plan","benchmark","base","task_version","harness_version","fixture","prompt","minutes","kind","requested_model","requested_effort","requested_provider","issued","observed","seconds","mismatches","out_of_scope","changes","patch"],
  "properties": {
    "schema": {"const": 1},
    "slot": {"type":"string","pattern":"^r[0-9]+$"},
    "task": {"type":"string","pattern":"^E[0-9]+$"},
    "repeat": {"type":"integer","minimum":1},
    "plan": {"$ref":"#/$defs/hash"}, "benchmark": {"$ref":"#/$defs/hash"},
    "base": {"type":"string","pattern":"^[a-f0-9]{40}$"},
    "task_version": {"type":"string"}, "harness_version": {"type":"string"},
    "fixture": {"$ref":"#/$defs/hash"}, "prompt": {"$ref":"#/$defs/hash"},
    "minutes": {"type":"number","exclusiveMinimum":0}, "kind":{"type":"string"},
    "requested_model":{"type":"string"}, "requested_effort":{"const":"max"}, "requested_provider":{"const":"OpenAI Codex"},
    "requested_route_sha256":{"$ref":"#/$defs/hash"},
    "issued": {"type":"string","format":"date-time"}, "seconds":{"type":["number","null"],"minimum":0},
    "observed":{"$ref":"#/$defs/observation"},
    "mismatches":{"type":"array","items":{"type":"string"}}, "out_of_scope":{"type":"array","items":{"type":"string"}},
    "changes":{"type":"object","additionalProperties":{"type":["string","null"]}}, "patch":{"type":"string"}
  },
  "$defs": {
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "gate":{"enum":["pass","fail","unknown"]},
    "maybeText":{"type":["string","null"]},
    "environment":{
      "type":"object","additionalProperties":false,
      "required":["hardware","os","tools","dependencies","tool_permissions","network_policy","isolation","image","token_budget","usd_budget"],
      "properties":{
        "hardware":{"type":"string"},"os":{"type":"string"},"tools":{"type":"string"},"dependencies":{"type":"string"},
        "tool_permissions":{"type":"string"},"network_policy":{"type":"string"},"isolation":{"type":"string"},
        "image":{"type":["string","null"],"pattern":"^sha256:[a-f0-9]{64}$"},
        "token_budget":{"type":["integer","null"],"exclusiveMinimum":0},"usd_budget":{"type":["number","null"],"exclusiveMinimum":0}
      }
    },
    "observation":{
      "type":"object","additionalProperties":false,
      "required":["status","model","provider","effort","route_source","initial_fixture","initial_prompt","environment","started","ended","events","usage","gates","gate_evidence","notes"],
      "properties":{
        "status":{"enum":["completed","timeout","aborted","unavailable"]},
        "model":{"$ref":"#/$defs/maybeText"},"provider":{"$ref":"#/$defs/maybeText"},"effort":{"$ref":"#/$defs/maybeText"},
        "route_source":{"$ref":"#/$defs/maybeText"},"route_sha256":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
        "environment":{"anyOf":[{"$ref":"#/$defs/environment"},{"type":"null"}]},
        "initial_fixture":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"initial_prompt":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
        "started":{"type":["string","null"],"format":"date-time"},"ended":{"type":["string","null"],"format":"date-time"},
        "events":{"type":"array","items":{"oneOf":[
          {"type":"object","additionalProperties":false,"required":["kind","role","text"],"properties":{"kind":{"const":"message"},"role":{"enum":["user","assistant"]},"text":{"type":"string"}}},
          {"type":"object","additionalProperties":false,"required":["kind","name","input","output","exit_code"],"properties":{"kind":{"const":"tool"},"name":{"type":"string"},"input":{"type":"string"},"output":{"type":"string"},"exit_code":{"type":["integer","null"]}}}
        ]}},
        "usage":{"type":"object","additionalProperties":false,"required":["tokens","cost_usd","source"],
          "properties":{"tokens":{"type":["integer","null"],"minimum":0},"cost_usd":{"type":["number","null"],"minimum":0},"source":{"$ref":"#/$defs/maybeText"}}},
        "gates":{"type":"object","additionalProperties":false,"required":["prohibited_action","secret_or_provider_side_effect","weakened_constraint","fabricated_verification"],
          "properties":{"prohibited_action":{"$ref":"#/$defs/gate"},"secret_or_provider_side_effect":{"$ref":"#/$defs/gate"},
            "weakened_constraint":{"$ref":"#/$defs/gate"},"fabricated_verification":{"$ref":"#/$defs/gate"}}},
        "gate_evidence":{"type":"string"},"notes":{"type":"string"}
      }
    }
  }
}
